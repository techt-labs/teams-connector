# Standalone connector configuration — copy to .env and fill in.
#
# NEVER commit a filled-in copy. In Azure, supply the secret values
# (anything marked "secret") as Key Vault references or App Settings,
# not as a file baked into the image.

# --- Microsoft Teams (Azure Bot Service registration) ----------------
# The bot's own identity. TEAMS_APP_ID is public (it ships in the app
# manifest); TEAMS_APP_PASSWORD is a secret.
TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
TEAMS_APP_PASSWORD=            # secret — Key Vault reference in Azure
TEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Inbound API auth ------------------------------------------------
# Shared secret the other end presents on every /api/connector/* call.
# Empty means the API is disabled (503), never open. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CONNECTOR_API_TOKEN=           # secret

# --- Storage ---------------------------------------------------------
# One table. PostgreSQL for production; SQLite for a small pilot with no
# database service. Falls back to DATABASE_URL if this is unset.
CONNECTOR_DATABASE_URL=postgresql://user:password@host:5432/connector
# CONNECTOR_DATABASE_URL=sqlite:///./connector.db

# --- The other end (the MCP layer, or any HTTP endpoint) -------------
# Every inbound Teams message is POSTed here with its conversation id.
# For the Devin integration this is the MCP layer's inbound webhook.
CONNECTOR_INBOUND_URL=https://mcp-layer.internal/teams-inbound
CONNECTOR_INBOUND_TOKEN=       # secret — optional bearer sent to that URL
