# Teams connector configuration — copy to .env and fill in.
#
# NEVER commit a filled-in copy. In Azure, supply the secret values
# (anything marked "secret") as Key Vault references or App Settings,
# not as a file baked into the image.

# --- Microsoft Teams (Azure Bot Service registration) ----------------
# The bot's own identity. TEAMS_APP_ID is public (it ships in the app
# manifest); TEAMS_APP_PASSWORD is a secret. Where each value comes
# from: GETTING_STARTED.md Step 1.
TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
# secret — Key Vault reference in Azure
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=00000000-0000-0000-0000-000000000000

# --- Inbound API auth ------------------------------------------------
# Shared secret the other end presents on every /api/connector/* call.
# Empty means the API is disabled (503), never open. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# secret
CONNECTOR_API_TOKEN=

# --- Storage ---------------------------------------------------------
# When using `docker compose up`, IGNORE this: compose assembles the
# URL from the POSTGRES_* values below. Set it only when running the
# service directly against your own database (e.g. Azure Database for
# PostgreSQL), or as sqlite:///./connector.db for a no-database pilot.
#CONNECTOR_DATABASE_URL=postgresql://user:password@host:5432/connector

# --- Database container (used by docker-compose.yml only) ------------
# The compose file starts a PostgreSQL container with these values and
# wires the service to it. PASSWORD is required — compose refuses to
# start without it.
# secret — REQUIRED for docker compose
POSTGRES_PASSWORD=
POSTGRES_USER=connector
POSTGRES_DB=connector
# host port the service is published on
CONNECTOR_PORT=8000

# --- The other end (where inbound Teams messages are forwarded) ------
# Every inbound Teams message is POSTed here with its conversation id.
# For the agent bridge this is the teams-agent-mcp service's
# /teams-inbound endpoint. LEAVE EMPTY on first deploy — you will not
# have this URL until that service is up (its GETTING_STARTED tells you
# to come back and set it); empty simply means nothing is forwarded yet.
CONNECTOR_INBOUND_URL=
# secret — bearer sent with each forward; the receiver must expect it
CONNECTOR_INBOUND_TOKEN=
